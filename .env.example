# Copy to .env.local. Values stay out of git; Vercel has its own copy.

# HMAC key for the offer / request / result tokens (32+ random bytes, hex)
TOKEN_SECRET=

# City office EdDSA key (32 bytes hex). Its public key is lib/zk/issuer-public.json;
# regenerate that with `ISSUER_PRIVATE_KEY=... npx tsx scripts/issuer-key.ts`.
ISSUER_PRIVATE_KEY=

# mock | groth16. groth16 needs ISSUER_PRIVATE_KEY above (see docs/technical.md, Running locally).
PROVER_MODE=mock
# device | server (default device). Where groth16 proofs are made: in the phone's
# browser, with /api/prove as the fallback, or always on the server.
PROVE_ON=device

# off | sepolia. With sepolia, Mingle's relayer records each proof in the registry.
CHAIN_MODE=off
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Addresses are in lib/chain/deployment-11155111.json
REGISTRY_ADDRESS=
# Demo-only key that pays gas on Sepolia. Never reuse on mainnet.
RELAYER_PRIVATE_KEY=

# simulated | idkit. With idkit, the human check uses World ID through IDKit 4,
# but only when every value below is set; otherwise it stays simulated.
WORLDID_MODE=simulated
# From the World Developer Portal (developer.world.org)
WORLDID_APP_ID=
WORLDID_RP_ID=
WORLDID_ACTION=das-busters-human
# staging (World ID Simulator) | production (World App)
WORLDID_ENVIRONMENT=staging
# Signer key registered with the RP (32 bytes hex). Only its address goes to the Portal.
WORLDID_RP_SIGNING_KEY=
# Staging only: token from `npx tsx --env-file=.env.local scripts/world-staging.ts`.
# The Portal's staging window lasts 24 hours; reopening replaces the token.
WORLDID_STAGING_TOKEN=
# When that window closes (ISO time). After it, the server falls back to simulated.
WORLDID_STAGING_EXPIRES_AT=
# Team API key for scripts/world-staging.ts only. The app never reads it.
WORLD_PORTAL_API_KEY=

# Privy app for Google sign-in (Phase 4)
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: base URL encoded in the counter QR (defaults to the page origin)
NEXT_PUBLIC_DEMO_BASE_URL=
