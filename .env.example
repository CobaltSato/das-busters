# Copy to .env.local. Values stay out of git; Vercel has its own copy.

# HMAC key for the offer / request / result tokens (32+ random bytes, hex)
TOKEN_SECRET=

# City office EdDSA key (32 bytes hex). Its public key is lib/zk/issuer-public.json;
# regenerate that with `ISSUER_PRIVATE_KEY=... npx tsx scripts/issuer-key.ts`.
ISSUER_PRIVATE_KEY=

# mock | groth16
PROVER_MODE=groth16

# off | sepolia. With sepolia, Mingle's relayer records each proof in the registry.
CHAIN_MODE=off
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Addresses are in lib/chain/deployment-11155111.json
REGISTRY_ADDRESS=
# Demo-only key that pays gas on Sepolia. Never reuse on mainnet.
RELAYER_PRIVATE_KEY=

# simulated | idkit (Phase 5)
WORLDID_MODE=simulated

# Privy app for Google sign-in (Phase 4)
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: base URL encoded in the counter QR (defaults to the page origin)
NEXT_PUBLIC_DEMO_BASE_URL=
